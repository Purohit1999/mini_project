# Runtime mode
# offline = deterministic classroom demo without an API key
# live = real OpenAI calls
DEMO_MODE=offline

# OpenAI — required only when DEMO_MODE=live
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2

# LangSmith — optional tracing for live mode
# LangSmith uses LANGSMITH_* variables in current SDK versions.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=BIA_Mini_Project_Sprint_Travel_Planner
